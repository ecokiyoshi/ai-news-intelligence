{
  "manifestVersion": 5,
  "id": "com.ecokiyoshi.ai-news-intelligence.timeline-builder",
  "name": "AI News Timeline Builder",
  "version": "1.0.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "ai-news-timeline-builder",
      "label": { "default": "AI News Timeline Builder" },
      "minimumSize": { "width": 300, "height": 360 },
      "preferredDockedSize": { "width": 360, "height": 520 }
    }
  ],
  "requiredPermissions": { "localFileSystem": "request" }
}
