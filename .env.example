APP_DOMAIN=
APP_IMAGE=ghcr.io/ecokiyoshi/ai-news-intelligence:latest
# Production should keep this enabled. Use a long, unique password.
DASHBOARD_AUTH_REQUIRED=true
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-2

# Claude (Anthropic) text provider. Set SCHEDULER_PROVIDER=anthropic to use it; scene
# image generation still falls back to the deterministic local generator because
# Anthropic has no Images API equivalent.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

APP_DATA_DIR=runtime-data
DATABASE_URL=
OUTPUT_DIR=generated-outputs

PIPELINE_MODE=end_to_end
# Opt in to stopping after dialogue generation for human editorial review.
EDITORIAL_REVIEW_REQUIRED=false

# local | openai | anthropic
SCHEDULER_PROVIDER=openai
SCHEDULER_FEED_URLS=
SCHEDULER_INTERVAL_SECONDS=3600
SCHEDULER_RELEVANCE_TARGET=

PIPELINE_NEWS_LIMIT=10

YOUTUBE_CHANNEL_FOCUS=
YOUTUBE_IDEA_COUNT=3
YOUTUBE_PACKAGING_COUNT=5
YOUTUBE_TARGET_MINUTES=15
YOUTUBE_SCENE_LIMIT=50
YOUTUBE_IMAGE_SIZE=1792x1024

TZ=Asia/Tokyo
ELEVENLABS_API_KEY=
ELEVENLABS_SABISUKE_VOICE_ID=
ELEVENLABS_HARU_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_DIALOGUE_GAP_MS=200
ELEVENLABS_TIMEOUT_SECONDS=60
ELEVENLABS_LANGUAGE_CODE=ja
ELEVENLABS_USE_PRONUNCIATION_MAP=false
